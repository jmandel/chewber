{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chewber.local/schemas/food_abstraction.schema.json",
  "title": "ChewberFoodAbstraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "zagat_line",
    "identification",
    "classification",
    "nutrition_per_100",
    "ingredients",
    "additives",
    "flags",
    "organic",
    "sources",
    "notes",
    "eligibility"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "zagat_line": {
      "type": "string",
      "minLength": 20,
      "maxLength": 140,
      "description": "REQUIRED. A single Zagat-style summary sentence (20-140 chars). Vivid, opinionated, concise — describes taste, quality, and health profile. Always generate one even if the report omits it. Example: 'This crispy, salty classic delivers bold crunch but sky-high sodium and a laundry list of additives dock it hard.'"
    },
    "identification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_name",
        "brand",
        "barcode",
        "kind",
        "market_country",
        "language"
      ],
      "properties": {
        "canonical_name": {
          "type": "string"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "barcode": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "prepared",
            "natural",
            "unknown"
          ]
        },
        "market_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nutri_score_category",
        "is_water",
        "is_reconstituted",
        "prepared_basis",
        "fvp_percent"
      ],
      "properties": {
        "nutri_score_category": {
          "type": "string",
          "enum": [
            "general_food",
            "beverage",
            "added_fat",
            "cheese",
            "unknown"
          ]
        },
        "is_water": {
          "type": "boolean"
        },
        "is_reconstituted": {
          "type": "boolean"
        },
        "prepared_basis": {
          "type": "string",
          "enum": [
            "as_sold",
            "as_prepared",
            "unknown"
          ]
        },
        "fvp_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "nutrition_per_100": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_basis",
        "energy_kj",
        "sugars_g",
        "saturated_fat_g",
        "total_fat_g",
        "sodium_mg",
        "salt_g",
        "protein_g",
        "fiber_g"
      ],
      "properties": {
        "unit_basis": {
          "type": "string",
          "enum": [
            "per_100g",
            "per_100ml",
            "unknown"
          ]
        },
        "energy_kj": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "energy_kcal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sugars_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "saturated_fat_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_fat_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sodium_mg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "salt_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "protein_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fiber_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ingredients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredients_text"
      ],
      "properties": {
        "ingredients_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "additives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "detection"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "detection": {
            "type": "string",
            "enum": [
              "label",
              "database",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_partially_hydrogenated_oils",
        "contains_fully_hydrogenated_oils"
      ],
      "properties": {
        "contains_partially_hydrogenated_oils": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "contains_fully_hydrogenated_oils": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      }
    },
    "organic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_certified_organic",
        "evidence"
      ],
      "properties": {
        "is_certified_organic": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "rationale",
        "missing_fields"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoring_track", "not_rated_reason"],
      "properties": {
        "scoring_track": {
          "type": "string",
          "enum": ["standard", "not_rated"]
        },
        "not_rated_reason": {
          "type": ["string", "null"]
        }
      }
    }
  }
}