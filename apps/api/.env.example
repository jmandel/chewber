# Chewber API — Environment Configuration
# Copy to .env and fill in your keys:
#   cp .env.example .env

# ── Server ────────────────────────────────────────────
CHEWBER_PORT=8000
CHEWBER_DB_PATH=../../data/chewber.sqlite
CHEWBER_UPLOAD_DIR=./uploads

# ── Reference data paths ──────────────────────────────
# These default to data/ relative to repo root; override for non-standard layouts.
# CHEWBER_REF_DB_PATH=../../data/usda.sqlite
# OFF_PARQUET_PATH=../../data/off-food.parquet
# OFF_INDEX_PATH=../../data/off-index.sqlite
# CHEWBER_RESEARCH_PATH=../../research/additives

# ── LLM Provider ──────────────────────────────────────
# stub       = no external calls, returns placeholder data (default)
# openrouter = OpenRouter API (requires OPENROUTER_API_KEY)
CHEWBER_LLM_PROVIDER=stub

# OpenRouter (when CHEWBER_LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview

# ── External APIs (optional) ──────────────────────────
# USDA FoodData Central — free key at https://api.nal.usda.gov
# Falls back to DEMO_KEY (1000 req/hr) if not set
USDA_API_KEY=
# Brave Search API — free tier at https://brave.com/search/api/ (2000 queries/month)
# If not set, falls back to DuckDuckGo (may be CAPTCHA-blocked)
BRAVE_SEARCH_API_KEY=

# ── Worker ────────────────────────────────────────────
# Max parallel research jobs per worker process
CHEWBER_WORKER_CONCURRENCY=3

# ── CORS ──────────────────────────────────────────────
# Use * for development, restrict in production
CHEWBER_WEB_ORIGIN=*

# ── Admin ─────────────────────────────────────────────
# If set, DELETE /api/foods/:id requires X-Admin-Key header to match
# CHEWBER_ADMIN_KEY=
