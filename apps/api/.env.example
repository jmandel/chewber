# Chewber API — Environment Configuration
# Copy to .env and fill in your keys:
#   cp .env.example .env

# ── Server ────────────────────────────────────────────
CHEWBER_PORT=8000
CHEWBER_DB_PATH=./chewber.sqlite
CHEWBER_UPLOAD_DIR=./uploads

# ── LLM Provider ──────────────────────────────────────
# stub      = no external calls, returns placeholder data (default)
# openai    = OpenAI API (requires OPENAI_API_KEY)
# openrouter = OpenRouter API (requires OPENROUTER_API_KEY)
CHEWBER_LLM_PROVIDER=stub

# OpenAI (when CHEWBER_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter (when CHEWBER_LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# ── External APIs (optional) ──────────────────────────
# USDA FoodData Central — free key at https://api.nal.usda.gov
# Falls back to DEMO_KEY (1000 req/hr) if not set
USDA_API_KEY=
# Brave Search API — free tier at https://brave.com/search/api/ (2000 queries/month)
# If not set, falls back to DuckDuckGo (may be CAPTCHA-blocked)
BRAVE_SEARCH_API_KEY=

# ── CORS ──────────────────────────────────────────────
# Use * for development, restrict in production
CHEWBER_WEB_ORIGIN=*
